def get_tv_client(tv_user: str, tv_pass: str):
    u = tv_user.strip() if tv_user else ""
    p = tv_pass.strip() if tv_pass else ""
    if u and p:
        return TvDatafeed(u, p)
    return TvDatafeed()


def clean_df(df):
    cols = ["open", "high", "low", "close"]
    if "volume" in df.columns:
        cols.append("volume")
    df = df[cols].astype(float).dropna()
    if "volume" not in df.columns:
        df["volume"] = 0.0
    return df[~df.index.duplicated(keep="last")].sort_index()


def drop_partial_last_bar(df):
    if not DROP_PARTIAL_LAST_BAR or df is None or df.empty:
        return df
    try:
        from zoneinfo import ZoneInfo
        now = pd.Timestamp.now(tz=ZoneInfo(MARKET_TZ)).tz_localize(None)
    except Exception:
        now = pd.Timestamp.now()
    today = now.normalize()
    close_t = today + pd.Timedelta(hours=MARKET_CLOSE_HHMM[0], minutes=MARKET_CLOSE_HHMM[1])
    if df.index[-1] >= today and now < close_t:
        df = df.iloc[:-1]
    return df


def download_stock(tv, sym, n_bars=N_BARS):
    for _ in range(3):
        try:
            raw = tv.get_hist(symbol=sym, exchange=EXCHANGE, interval=Interval.in_daily, n_bars=n_bars)
            if raw is not None and not raw.empty:
                df = raw.copy()
                df.columns = [c.lower() for c in df.columns]
                df.index = pd.DatetimeIndex(df.index).tz_localize(None).normalize()
                df = drop_partial_last_bar(clean_df(df))
                return df[df.index >= pd.Timestamp(DATA_START)]
        except Exception:
            time.sleep(0.7)
    return None


def prior_downtrend(close):
    s = pd.Series(close)
    ema = s.ewm(span=TREND_EMA, adjust=False).mean()
    down = (s < ema) & (ema < ema.shift(TREND_SLOPE))
    if USE_EMA200_FILTER:
        ema200 = s.ewm(span=LONG_EMA, adjust=False).mean()
        down = down & (s > ema200)
    return down.shift(1, fill_value=False).values.astype(bool)


def current_filter_status(close):
    s = pd.Series(close)
    ema = s.ewm(span=TREND_EMA, adjust=False).mean()
    down = (s < ema) & (ema < ema.shift(TREND_SLOPE))
    if USE_EMA200_FILTER:
        ema200 = s.ewm(span=LONG_EMA, adjust=False).mean()
        down = down & (s > ema200)
    return bool(down.iloc[-1])


def prev_period_lows(df):
    wk = df.index.to_period("W-THU")
    mo = df.index.to_period("M")
    wlow = df["low"].groupby(wk).min()
    mlow = df["low"].groupby(mo).min()
    pwl = wlow.shift(1).reindex(wk).values
    pml = mlow.shift(1).reindex(mo).values
    return pwl, pml


def build_smc_structures(o, h, l, c):
    L = len(c)
    swing_pivots = {}
    if USE_SWING_LOWS:
        w = SWING_WINDOW
        for piv in range(w, L - w):
            window_lows = l[piv - w: piv + w + 1]
            if l[piv] == np.min(window_lows) and np.sum(window_lows == l[piv]) == 1:
                swing_pivots[piv + w] = (piv, float(l[piv]))

    order_blocks = {}
    if USE_ORDER_BLOCKS:
        for k in range(1, L - 1):
            if c[k] < o[k] and c[k + 1] > o[k + 1]:
                impulse = (c[k + 1] - o[k + 1]) / o[k + 1]
                if impulse >= OB_IMPULSE_PCT and c[k + 1] > h[k]:
                    order_blocks[k + 1] = (k, float(l[k]), float(h[k]))

    return swing_pivots, order_blocks


def last_red_run_high(red, h, i, max_len=30):
    r = i
    while r >= 0 and not red[r] and i - r < max_len:
        r -= 1
    if r < 0 or not red[r]:
        return None
    run_high, k = h[r], r
    while k - 1 >= 0 and red[k - 1] and r - k < max_len:
        k -= 1
        run_high = max(run_high, h[k])
    return run_high


def update_trailing_stop_next_session(pos, bar_high, bar_low):
    entry = pos["entry"]
    pos["mfe"] = max(pos["mfe"], bar_high)
    mfe_pct = (pos["mfe"] / entry) - 1.0

    if mfe_pct >= 0.25:
        pos["post_25"] = True
        pos["max_tier"] = "25%+"
        new_stop = max(entry * 1.15, bar_low)
        pos["stop"] = max(pos["stop"], new_stop)
    elif mfe_pct >= 0.15:
        pos["max_tier"] = "15%"
        pos["stop"] = max(pos["stop"], entry * 1.10)
    elif mfe_pct >= 0.10:
        pos["max_tier"] = "10%"
        pos["stop"] = max(pos["stop"], entry * 1.075)
    elif mfe_pct >= 0.075:
        pos["max_tier"] = "7.5%"
        pos["stop"] = max(pos["stop"], entry * 1.05)
    elif mfe_pct >= 0.05:
        pos["max_tier"] = "5%"
        pos["stop"] = max(pos["stop"], entry * 1.00)


def close_trade(tk, pos, i, ex, reason, dates):
    ret = ex / pos["entry"] - 1 - 2 * COMMISSION
    return dict(
        ticker=tk,
        entry_date=dates[pos["i0"]],
        exit_date=dates[i],
        swept=pos["kind"],
        entry=round(pos["entry"], 3),
        final_stop=round(pos["stop"], 3),
        exit=round(ex, 3),
        reason=reason,
        max_tier=pos["max_tier"],
        ret_pct=round(ret * 100, 2),
        R=round(ret / pos["risk"], 2),
        mfe_pct=round((pos["mfe"] / pos["entry"] - 1) * 100, 2),
        bars=i - pos["i0"],
        swept_level=round(pos["level"], 3)
    )


def run_stock(tk, df, alloc_per_trade):
    o, h, l, c = (df[x].values for x in ("open", "high", "low", "close"))
    dates = df.index
    L = len(df)
    red = c < o
    down = prior_downtrend(c)
    pwl, pml = prev_period_lows(df)
    swing_pivots, order_blocks = build_smc_structures(o, h, l, c)
    start_ts = pd.Timestamp(TEST_START)

    active_swings = []
    active_obs = []
    used_wm, state, pos, s, trades = set(), "IDLE", None, {}, []

    for i in range(L):
        if i in swing_pivots:
            piv_i, p_val = swing_pivots[i]
            active_swings.append(dict(piv_i=piv_i, price=p_val, used=False))
        if i in order_blocks:
            ob_i, ob_l, ob_h = order_blocks[i]
            active_obs.append(dict(ob_i=ob_i, low=ob_l, high=ob_h, used=False))

        active_swings = [sw for sw in active_swings if (i - sw["piv_i"] <= SWING_MAX_AGE) and not sw["used"]]
        active_obs = [ob for ob in active_obs if (i - ob["ob_i"] <= OB_MAX_AGE) and not ob["used"]]

        if pos is not None:
            if i > pos["i0"]:
                ex = reason = None
                if l[i] <= pos["stop"]:
                    ex = min(o[i], pos["stop"])
                    reason = "post25_drop" if pos["post_25"] else f"stop({pos['max_tier']})"
                elif (not pos["post_25"]) and (i - pos["i0"] >= MAX_HOLD):
                    ex = c[i]
                    reason = f"time({pos['max_tier']})"

                if ex is not None:
                    trades.append(close_trade(tk, pos, i, ex, reason, dates))
                    pos, state = None, "IDLE"
                else:
                    update_trailing_stop_next_session(pos, h[i], l[i])

            for sw in active_swings:
                if c[i] < sw["price"]:
                    sw["used"] = True
            for ob in active_obs:
                if c[i] < ob["low"]:
                    ob["used"] = True
            continue

        if state == "WAIT":
            if i - s["sweep_i"] > ENTRY_TIMEOUT:
                state = "IDLE"
            else:
                trigger = s["run_high"]
                if h[i] >= trigger:
                    fill = max(o[i], trigger)
                    stop = fill * (1 - STOP_PCT)
                    state = "IDLE"
                    pos = dict(
                        i0=i, entry=fill, stop=stop, risk=STOP_PCT, mfe=fill,
                        level=s["level"], kind=s["kind"],
                        sweep_low=s["sweep_low"], sweep_i=s["sweep_i"],
                        max_tier="0%", post_25=False
                    )
                    if l[i] <= stop:
                        trades.append(close_trade(tk, pos, i, stop, "stop(0%)", dates))
                        pos = None
                    else:
                        update_trailing_stop_next_session(pos, h[i], l[i])
                    continue
                if c[i] < s["level"]:
                    state = "IDLE"
                    continue
                s["sweep_low"] = min(s["sweep_low"], l[i])
                if red[i]:
                    s["run_high"] = max(s["run_high"], h[i]) if s["last_red"] else h[i]
                s["last_red"] = bool(red[i])

        if state == "IDLE" and dates[i] >= start_ts and down[i]:
            candle_ok = True
            if USE_CANDLE_FILTER:
                rng = h[i] - l[i]
                if rng <= 0 or (c[i] - l[i]) / rng < SWEEP_CLOSE_POS:
                    candle_ok = False

            if candle_ok:
                sweep_hits = []
                if not np.isnan(pwl[i]) and l[i] < pwl[i] and c[i] > pwl[i]:
                    if ("week", round(float(pwl[i]), 4)) not in used_wm:
                        sweep_hits.append(("week", float(pwl[i]), float(pwl[i])))

                if not np.isnan(pml[i]) and l[i] < pml[i] and c[i] > pml[i]:
                    if ("month", round(float(pml[i]), 4)) not in used_wm:
                        sweep_hits.append(("month", float(pml[i]), float(pml[i])))

                matched_swings = []
                for sw in active_swings:
                    if l[i] < sw["price"] and c[i] > sw["price"]:
                        sweep_hits.append(("swing_low", sw["price"], sw["price"]))
                        matched_swings.append(sw)

                ob_hits = []
                matched_obs = []
                for ob in active_obs:
                    if l[i] <= ob["high"] and c[i] > ob["low"] and i > ob["ob_i"] + 2:
                        ob_hits.append(("order_block", ob["low"], ob["high"]))
                        matched_obs.append(ob)

                if sweep_hits or (ALLOW_STANDALONE_OB and ob_hits):
                    hits = sweep_hits + ob_hits
                    seen_k = []
                    for k, _, _ in hits:
                        if k not in seen_k:
                            seen_k.append(k)

                    if not ALLOW_MULTI_CONFLUENCE and len(seen_k) > 2:
                        pass
                    else:
                        rh = last_red_run_high(red, h, i)
                        if rh is not None:
                            for sw in matched_swings:
                                sw["used"] = True
                            for ob in matched_obs:
                                ob["used"] = True
                            for k, inv_lvl, _ in hits:
                                if k in ("week", "month"):
                                    used_wm.add((k, round(inv_lvl, 4)))
                            kind_lbl = "+".join(seen_k) if len(seen_k) <= 2 else "multi_confluence"
                            invalidation_lvl = min(x[1] for x in hits)
                            s = dict(
                                level=invalidation_lvl, kind=kind_lbl,
                                sweep_low=l[i], sweep_i=i, run_high=rh, last_red=bool(red[i])
                            )
                            state = "WAIT"

        for sw in active_swings:
            if c[i] < sw["price"]:
                sw["used"] = True
        for ob in active_obs:
            if c[i] < ob["low"]:
                ob["used"] = True

    live_info = None
    last_close = float(c[-1])
    if pos is not None:
        trades.append(close_trade(tk, pos, L - 1, last_close, "open", dates))
        pnl_pct = (last_close / pos["entry"] - 1.0) * 100
        shares = int(alloc_per_trade // pos["entry"]) if pos["entry"] > 0 else 0
        live_info = dict(
            status="OPEN",
            ticker=tk,
            entry_date=dates[pos["i0"]].strftime("%Y-%m-%d"),
            entry=round(pos["entry"], 3),
            last_close=round(last_close, 3),
            pnl_pct=round(pnl_pct, 2),
            stop=round(pos["stop"], 3),
            tier="POST-25% TRAIL" if pos["post_25"] else f"Tier {pos['max_tier']}",
            kind=pos["kind"],
            bars=(L - 1) - pos["i0"],
            suggested_shares=shares
        )
    elif state == "WAIT":
        rem_bars = ENTRY_TIMEOUT - ((L - 1) - s["sweep_i"])
        if rem_bars > 0:
            dist_trigger = (s["run_high"] / last_close - 1.0) * 100
            shares = int(alloc_per_trade // s["run_high"]) if s["run_high"] > 0 else 0
            live_info = dict(
                status="WAIT",
                ticker=tk,
                sweep_date=dates[s["sweep_i"]].strftime("%Y-%m-%d"),
                trigger=round(s["run_high"], 3),
                last_close=round(last_close, 3),
                dist_pct=round(dist_trigger, 2),
                est_stop=round(s["run_high"] * (1 - STOP_PCT), 3),
                invalidation=round(s["level"], 3),
                kind=s["kind"],
                rem_bars=rem_bars,
                suggested_shares=shares
            )

    radar_hits = []
    last_pwl = float(pwl[-1]) if not np.isnan(pwl[-1]) else np.nan
    last_pml = float(pml[-1]) if not np.isnan(pml[-1]) else np.nan
    filt_ok = current_filter_status(c)

    if not np.isnan(last_pwl) and last_close >= last_pwl:
        d_w = (last_close - last_pwl) / last_pwl * 100
        if 0.0 <= d_w <= 2.0:
            radar_hits.append(dict(
                ticker=tk,
                close=round(last_close, 3),
                ref_type="Week Low",
                ref_val=round(last_pwl, 3),
                dist_pct=round(d_w, 2),
                filter_ok=filt_ok
            ))

    if not np.isnan(last_pml) and last_close >= last_pml:
        d_m = (last_close - last_pml) / last_pml * 100
        if 0.0 <= d_m <= 2.0:
            radar_hits.append(dict(
                ticker=tk,
                close=round(last_close, 3),
                ref_type="Month Low",
                ref_val=round(last_pml, 3),
                dist_pct=round(d_m, 2),
                filter_ok=filt_ok
            ))

    return trades, live_info, radar_hits


def simulate_virtual_portfolio(tr, initial_capital=100000.0, max_positions=5):
    if tr.empty:
        return None, None

    df_tr = tr.sort_values(["entry_date", "exit_date"]).reset_index(drop=True)
    cash = initial_capital
    active_positions = []
    equity_curve = []
    executed_count = 0
    skipped_count = 0

    all_dates = sorted(list(set(df_tr["entry_date"]).union(set(df_tr["exit_date"]))))

    for current_date in all_dates:
        remaining = []
        for pos in active_positions:
            if pos["exit_date"] <= current_date:
                cash += pos["allocated"] * (1.0 + pos["ret_pct"] / 100.0)
            else:
                remaining.append(pos)
        active_positions = remaining

        todays_entries = df_tr[df_tr["entry_date"] == current_date]
        for _, row in todays_entries.iterrows():
            if len(active_positions) < max_positions:
                total_equity = cash + sum(p["allocated"] for p in active_positions)
                alloc = min(cash, total_equity / max_positions)
                if alloc > 0:
                    cash -= alloc
                    active_positions.append({
                        "entry_date": row["entry_date"],
                        "exit_date": row["exit_date"],
                        "allocated": alloc,
                        "ret_pct": row["ret_pct"]
                    })
                    executed_count += 1
            else:
                skipped_count += 1

        current_equity = cash + sum(p["allocated"] for p in active_positions)
        equity_curve.append({"date": current_date, "equity": round(current_equity, 2)})

    eq_df = pd.DataFrame(equity_curve)
    eq_df["peak"] = eq_df["equity"].cummax()
    eq_df["dd_pct"] = (eq_df["equity"] - eq_df["peak"]) / eq_df["peak"] * 100.0

    stats = {
        "final_equity": eq_df["equity"].iloc[-1],
        "net_return_pct": (eq_df["equity"].iloc[-1] / initial_capital - 1.0) * 100.0,
        "max_dd_pct": eq_df["dd_pct"].min(),
        "executed": executed_count,
        "skipped": skipped_count
    }
    return eq_df, stats


