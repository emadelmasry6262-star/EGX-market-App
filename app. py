def close_paper_trade(trade_id: int, exit_date: str, exit_price: float):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT entry_price, shares FROM paper_trades WHERE id = ?", (trade_id,))
    row = c.fetchone()
    if row:
        entry_p, shares = float(row[0]), int(row[1])
        net_ret = (exit_price / entry_p) - 1.0 - 0.004
        pnl_egp = round(entry_p * shares * net_ret, 2)
        pnl_pct = round(net_ret * 100.0, 2)
        c.execute(
            """UPDATE paper_trades SET status = 'CLOSED', exit_date = ?, exit_price = ?, pnl_egp = ?, pnl_pct = ?
               WHERE id = ?""",
            (exit_date, exit_price, pnl_egp, pnl_pct, trade_id)
        )
        conn.commit()
    conn.close()


def update_paper_stop(trade_id: int, new_stop: float):
