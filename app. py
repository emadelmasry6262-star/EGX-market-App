# ============================ DATABASE & AUTH ============================
def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS users (
            username TEXT PRIMARY KEY,
            password_hash TEXT NOT NULL,
            tv_user TEXT DEFAULT '',
            tv_pass TEXT DEFAULT '',
            initial_cap REAL DEFAULT 100000.0,
            max_pos INTEGER DEFAULT 5,
            created_at TEXT
        )
    """)
    c.execute("""
        CREATE TABLE IF NOT EXISTS scan_history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            scan_time TEXT NOT NULL,
            market_date TEXT NOT NULL,
            open_count INTEGER,
            wait_count INTEGER,
            watchlist_count INTEGER,
            summary_text TEXT
        )
    """)
    c.execute("""
        CREATE TABLE IF NOT EXISTS paper_trades (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            ticker TEXT NOT NULL,
            entry_date TEXT NOT NULL,
            entry_price REAL NOT NULL,
            shares INTEGER NOT NULL,
            stop_loss REAL NOT NULL,
            status TEXT DEFAULT 'OPEN',
            exit_date TEXT,
            exit_price REAL,
            pnl_egp REAL DEFAULT 0.0,
            pnl_pct REAL DEFAULT 0.0,
            notes TEXT DEFAULT ''
        )
    """)
    conn.commit()
    conn.close()


def hash_pwd(pwd: str) -> str:
    return hashlib.sha256(pwd.encode("utf-8")).hexdigest()


def register_user(username: str, password: str):
    u = username.strip().lower()
    if len(u) < 3 or len(password) < 4:
        return False, "اسم المستخدم يجب أن يكون 3 أحرف على الأقل وكلمة المرور 4 أحرف."
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT username FROM users WHERE username = ?", (u,))
    if c.fetchone():
        conn.close()
        return False, "اسم المستخدم مسجل بالفعل."
    c.execute(
        "INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?)",
        (u, hash_pwd(password), datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
    )
    conn.commit()
    conn.close()
    return True, "تم إنشاء الحساب بنجاح! يمكنك تسجيل الدخول الآن."


def verify_user(username: str, password: str):
    u = username.strip().lower()
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute(
        "SELECT username, password_hash, tv_user, tv_pass, initial_cap, max_pos FROM users WHERE username = ?",
        (u,)
    )
    row = c.fetchone()
    conn.close()
    if row and row[1] == hash_pwd(password):
        return {
            "username": row[0],
            "tv_user": row[2] or "",
            "tv_pass": row[3] or "",
            "initial_cap": float(row[4] or 100000.0),
            "max_pos": int(row[5] or 5),
        }
    return None


